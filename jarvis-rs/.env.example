# Required for browser TYPE_TEXT helper (NVIDIA NIM Nemotron)
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
TEXT_MODEL_REASONING=none
